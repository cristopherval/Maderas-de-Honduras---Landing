---
/**
 * La estrella de la marca. Fuera del logo aparece exactamente dos veces en todo
 * el sitio: en el divisor único de la portada y en el indicador de umbral de la
 * barra fija. Si aparece una tercera vez, algo se salió del plan.
 */
interface Props {
  rellena?: boolean;
  /** Lado en píxeles. */
  tamano?: number;
  class?: string;
}

const { rellena = true, tamano = 12, class: clase = '' } = Astro.props;

const TRAZO =
  'M0,-1 L0.225,-0.309 L0.951,-0.309 L0.363,0.118 L0.588,0.809 ' +
  'L0,0.382 L-0.588,0.809 L-0.363,0.118 L-0.951,-0.309 L-0.225,-0.309 Z';
---

<svg
  viewBox="-1.15 -1.15 2.3 2.3"
  width={tamano}
  height={tamano}
  aria-hidden="true"
  focusable="false"
  class={clase}
>
  <path
    d={TRAZO}
    fill={rellena ? 'currentColor' : 'none'}
    stroke="currentColor"
    stroke-width={rellena ? 0 : 0.18}
    stroke-linejoin="round"
  />
</svg>
