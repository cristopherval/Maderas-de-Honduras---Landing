---
import { urlWhatsApp } from '@/lib/whatsapp';

interface Props {
  /** Mensaje precargado según la página. Nunca un "Hola" genérico. */
  mensaje: string;
}

const { mensaje } = Astro.props;
---

<a
  href={urlWhatsApp(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-flotante fixed right-4 z-30 flex h-14 w-14 items-center justify-center rounded-full bg-verde-monte text-cal hover:bg-ocote-tinta lg:right-6"
>
  <span class="sr-only">Escribir por WhatsApp</span>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path
      d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.22 8.22 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24Zm-2.6 4.2c-.16-.36-.33-.37-.48-.38h-.4c-.14 0-.37.05-.56.26-.19.21-.73.72-.73 1.75s.75 2.03.86 2.17c.1.14 1.45 2.32 3.57 3.16 1.76.7 2.12.56 2.5.52.38-.03 1.23-.5 1.4-.99.18-.48.18-.9.13-.99-.05-.09-.19-.14-.4-.24-.21-.1-1.23-.61-1.42-.68-.19-.07-.33-.1-.47.1-.14.21-.54.68-.66.82-.12.14-.24.16-.45.05-.21-.1-.88-.32-1.68-1.03-.62-.55-1.04-1.24-1.16-1.44-.12-.21-.01-.32.09-.42.09-.1.21-.24.31-.36.1-.12.14-.21.21-.35.07-.14.03-.26-.02-.36-.05-.1-.46-1.14-.64-1.56Z"
    ></path>
  </svg>
</a>

{/* El estilo del botón (posición, transiciones y el hover) vive en global.css,
    junto al resto del sistema de animación. */}
