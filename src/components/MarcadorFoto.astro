---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MarcadorFoto, ProporcionFoto } from '@/types/contenido';

/**
 * Mientras no haya sesión de fotos en la planta, esto pinta un bloque de color
 * con la instrucción de toma escrita. Sirve de lista de tomas para Josue.
 *
 * El pipeline ya está listo: en cuanto una entrada de contenido traiga
 * `foto.archivo`, se sirve la foto real con avif/webp, dimensiones explícitas
 * y carga diferida. No hay que tocar ninguna página.
 */
interface Props {
  foto: MarcadorFoto;
  /** Fondo del marcador. Solo tonos de la paleta. */
  tono?: 'monte' | 'tinta' | 'aserrin';
  /** La primera imagen visible de una página no se difiere. */
  prioritaria?: boolean;
  /**
   * Fuerza la proporción, ignorando la del contenido. Se usa en las grillas de
   * varias columnas: ahí las proporciones distintas desalinean los títulos y se
   * leen como descuido. La variedad de encuadre se aprovecha en las fichas,
   * donde cada foto está sola.
   */
  proporcion?: ProporcionFoto;
  class?: string;
}

const {
  foto,
  tono = 'monte',
  prioritaria = false,
  proporcion,
  class: clase = '',
} = Astro.props;

const proporcionFinal = proporcion ?? foto.proporcion;

// Clases literales para que el escáner de Tailwind las vea.
const CLASE_PROPORCION: Record<ProporcionFoto, string> = {
  '16/9': 'aspect-[16/9]',
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-[1/1]',
  '3/2': 'aspect-[3/2]',
};

// El tono `aserrin` lleva borde: sin él se pierde contra el fondo `cal` y el
// marcador se lee como un hueco en la maqueta en vez de como un bloque.
//
// Eran cuatro. El tono `musgo` se cayó porque ningún color de la paleta llega a
// 4.5:1 sobre #47825E — el mejor es `cal`, con 4.24 — y el marcador lleva dos
// líneas de texto encima. Es la misma razón por la que `verde-musgo` está
// prohibido como texto: no da contraste ni de un lado ni del otro.
const CLASE_TONO = {
  monte: 'bg-verde-monte text-aserrin',
  tinta: 'bg-verde-tinta text-aserrin',
  aserrin: 'bg-aserrin text-verde-monte border-hair border-verde-monte',
} as const;

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/fotos/*.{jpeg,jpg,png,webp,avif}',
);

const cargador = foto.archivo ? fotos[`/src/assets/fotos/${foto.archivo}`] : undefined;
const imagen = cargador ? (await cargador()).default : undefined;
---

{
  imagen ? (
    <Picture
      src={imagen}
      alt={foto.alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1280]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading={prioritaria ? 'eager' : 'lazy'}
      decoding={prioritaria ? 'sync' : 'async'}
      fetchpriority={prioritaria ? 'high' : 'auto'}
      class:list={['marcador-foto h-full w-full object-cover', CLASE_PROPORCION[proporcionFinal], clase]}
    />
  ) : (
    <div
      class:list={[
        'marcador-foto flex w-full flex-col justify-between gap-4 p-4',
        CLASE_PROPORCION[proporcionFinal],
        CLASE_TONO[tono],
        clase,
      ]}
    >
      {/* Sin opacidad: al 70% el rótulo caía a 2.3:1 contra su propio fondo.
          La jerarquía la da el tamaño, no la transparencia. */}
      <span class="font-dato text-spec-sm uppercase">Foto pendiente</span>
      <span class="font-dato text-dato-sm leading-snug">{foto.toma}</span>
    </div>
  )
}
