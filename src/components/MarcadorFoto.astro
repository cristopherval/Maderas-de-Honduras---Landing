---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MarcadorFoto, ProporcionFoto } from '@/types/contenido';

/**
 * Mientras no haya sesión de fotos en la planta, esto pinta un bloque de color
 * con la instrucción de toma escrita. Sirve de lista de tomas para Josue.
 *
 * El pipeline ya está listo: en cuanto una entrada de contenido traiga
 * `foto.archivo`, se sirve la foto real con avif/webp, dimensiones explícitas
 * y carga diferida. No hay que tocar ninguna página.
 */
interface Props {
  foto: MarcadorFoto;
  /** Fondo del marcador. Solo tonos de la paleta. */
  tono?: 'monte' | 'tinta' | 'musgo' | 'aserrin';
  /** La primera imagen visible de una página no se difiere. */
  prioritaria?: boolean;
  class?: string;
}

const { foto, tono = 'monte', prioritaria = false, class: clase = '' } = Astro.props;

// Clases literales para que el escáner de Tailwind las vea.
const CLASE_PROPORCION: Record<ProporcionFoto, string> = {
  '16/9': 'aspect-[16/9]',
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-[1/1]',
  '3/2': 'aspect-[3/2]',
};

const CLASE_TONO = {
  monte: 'bg-verde-monte text-aserrin',
  tinta: 'bg-verde-tinta text-aserrin',
  musgo: 'bg-verde-musgo text-verde-tinta',
  aserrin: 'bg-aserrin text-verde-monte',
} as const;

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/fotos/*.{jpeg,jpg,png,webp,avif}',
);

const cargador = foto.archivo ? fotos[`/src/assets/fotos/${foto.archivo}`] : undefined;
const imagen = cargador ? (await cargador()).default : undefined;
---

{
  imagen ? (
    <Picture
      src={imagen}
      alt={foto.alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1280]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading={prioritaria ? 'eager' : 'lazy'}
      decoding={prioritaria ? 'sync' : 'async'}
      fetchpriority={prioritaria ? 'high' : 'auto'}
      class:list={['marcador-foto h-full w-full object-cover', CLASE_PROPORCION[foto.proporcion], clase]}
    />
  ) : (
    <div
      class:list={[
        'marcador-foto flex w-full flex-col justify-between gap-4 p-4',
        CLASE_PROPORCION[foto.proporcion],
        CLASE_TONO[tono],
        clase,
      ]}
    >
      <span class="font-dato text-spec-sm uppercase opacity-70">Foto pendiente</span>
      <span class="font-dato text-dato-sm leading-snug">{foto.toma}</span>
    </div>
  )
}
