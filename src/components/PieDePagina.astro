---
import Logo from '@/components/Logo.astro';
import AyudaWhatsApp from '@/components/AyudaWhatsApp.astro';
import {
  DIRECCION,
  EMAIL_CONTACTO,
  HORARIO,
  NOTA_VOLUMEN,
  REDES,
  TELEFONOS,
  urlComoLlegar,
  urlTelefono,
} from '@/data/empresa';

const ENLACES = [
  { href: '/productos', texto: 'Productos' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/nosotros', texto: 'Nosotros' },
  { href: '/contacto', texto: 'Contacto' },
];
---

<footer class="bg-verde-tinta text-cal">
  {/* Última puerta abierta antes de que se vayan. Se separa del resto del pie
      por color —verde monte sobre verde tinta—, no por filete. */}
  <div class="bg-verde-monte">
    <div class="plano py-12 lg:py-14">
      <AyudaWhatsApp mensaje="Buen día. No encuentro lo que busco en el sitio. ¿Me pueden ayudar?" />
    </div>
  </div>

  <div class="plano grid gap-12 py-16 lg:grid-cols-[1.2fr_1fr_1fr] lg:gap-8 lg:py-20">
    <div>
      <Logo variante="claro" tamano={44} />
      <p class="mt-6 max-w-medida text-sm text-aserrin">
        Aserradero y planta procesadora. {NOTA_VOLUMEN}.
      </p>
    </div>

    <div>
      <h2 class="rotulo-claro">Ubicación</h2>
      <address class="mt-4 not-italic">
        <p class="max-w-medida text-sm text-cal">{DIRECCION.linea}</p>
        <ul class="mt-4 space-y-1">
          {
            TELEFONOS.map((telefono) => (
              <li>
                <a href={urlTelefono(telefono)} class="-my-1 inline-flex min-h-[44px] items-center font-dato text-dato text-cal transition-colors duration-micro ease-sierra hover:text-ocote">
                  {telefono}
                </a>
              </li>
            ))
          }
        </ul>
        {
          /* EMAIL_CONTACTO es null hasta que el cliente tenga correo. Mientras
             tanto no se pinta nada: un correo de relleno es peor que ninguno. */
          EMAIL_CONTACTO !== null && (
            <p class="mt-2">
              <a href={`mailto:${EMAIL_CONTACTO}`} class="enlace-claro text-sm">
                {EMAIL_CONTACTO}
              </a>
            </p>
          )
        }
      </address>
      <a href={urlComoLlegar()} target="_blank" rel="noopener noreferrer" class="boton-linea-claro mt-6">
        Cómo llegar
        <span class="flecha" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div>
      <h2 class="rotulo-claro">Horario</h2>
      <ul class="mt-4 space-y-1">
        {
          HORARIO.map((franja) => (
            <li class="flex flex-wrap justify-between gap-x-4 py-1 text-sm">
              <span class="text-aserrin">{franja.dias}</span>
              <span class="font-dato text-dato-sm text-cal">
                {franja.abre === null ? 'Cerrado' : `${franja.abre} – ${franja.cierra}`}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="rotulo-claro mt-10">Secciones</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1">
        {
          ENLACES.map((enlace) => (
            <li>
              <a href={enlace.href} class="-my-1 inline-flex min-h-[44px] items-center text-sm text-aserrin transition-colors duration-micro ease-sierra hover:text-ocote">
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>

      {
        /* REDES está vacío. Un pie con iconos sin enlace grita sitio abandonado,
           así que el bloque entero no se renderiza hasta que existan cuentas. */
        REDES.length > 0 && (
          <>
            <h2 class="rotulo-claro mt-10">Redes</h2>
            <ul class="mt-4 flex gap-4">
              {REDES.map((red) => (
                <li>
                  <a href={red.url} class="enlace-claro text-sm" rel="noopener noreferrer">
                    {red.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>

  {/* La franja inferior con la dirección repetida y el lema en versalitas se
      quitó: repetía lo que ya está tres columnas más arriba. */}
</footer>
