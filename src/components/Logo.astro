---
import { NOMBRE } from '@/data/empresa';

interface Props {
  /** `claro` sobre fondo oscuro, `oscuro` sobre fondo claro. */
  variante?: 'claro' | 'oscuro';
  /** El nombre solo aparece desde `sm`; en 360px queda la marca sola. */
  conNombre?: boolean;
  tamano?: number;
}

const { variante = 'oscuro', conNombre = true, tamano = 36 } = Astro.props;

const colorPino = variante === 'claro' ? '#F8F7F3' : '#1C4B34';
const colorEstrella = variante === 'claro' ? '#1C4B34' : '#F8F7F3';
const colorTexto = variante === 'claro' ? 'text-cal' : 'text-verde-tinta';

// TODO: sustituir por el trazado del logo real cuando el cliente lo entregue.
// Sin `<use>` ni `id` a propósito: el logo aparece en el encabezado y en el pie
// de la misma página, y los identificadores repetidos rompen el documento.
const CUERPOS_PINO = [
  'M0,-34 L9,-14 L-9,-14 Z',
  'M0,-24 L14,0 L-14,0 Z',
  'M0,-10 L17,18 L-17,18 Z',
  'M-2.5,18 h5 v8 h-5 Z',
];

const PINOS = [
  'translate(26 63.7) scale(0.78)',
  'translate(94 63.7) scale(0.78)',
  'translate(60 58)',
];

const ESTRELLA =
  'M0,-1 L0.225,-0.309 L0.951,-0.309 L0.363,0.118 L0.588,0.809 ' +
  'L0,0.382 L-0.588,0.809 L-0.363,0.118 L-0.951,-0.309 L-0.225,-0.309 Z';

const ESTRELLAS = [
  'translate(60 66) scale(4)',
  'translate(52 58) scale(3.6)',
  'translate(68 58) scale(3.6)',
  'translate(52 74) scale(3.6)',
  'translate(68 74) scale(3.6)',
];
---

<span class="inline-flex items-center gap-3">
  <svg
    viewBox="0 0 120 96"
    width={tamano}
    height={Math.round((tamano * 96) / 120)}
    role="img"
    aria-label={NOMBRE}
    class="shrink-0"
  >
    <g fill={colorPino}>
      {PINOS.map((posicion) => (
        <g transform={posicion}>
          {CUERPOS_PINO.map((trazo) => <path d={trazo} />)}
        </g>
      ))}
    </g>
    <g fill={colorEstrella}>
      {ESTRELLAS.map((posicion) => <path d={ESTRELLA} transform={posicion} />)}
    </g>
  </svg>

  {
    conNombre && (
      <span
        class:list={[
          'hidden font-display text-[0.8125rem] font-bold uppercase leading-[1.1] tracking-[0.06em] ancho-expandido sm:block',
          colorTexto,
        ]}
      >
        Maderas
        <br />
        de Honduras
      </span>
    )
  }
</span>
