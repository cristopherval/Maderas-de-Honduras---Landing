---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import MarcadorFoto from '@/components/MarcadorFoto.astro';
import heroe from '@/assets/fotos/heroe.jpg';
import { ETIQUETA_ACABADO, obtenerEspecies, obtenerProductos, obtenerServicios } from '@/lib/contenido';
import {
  ANIO_PLANTA_PROPIA,
  DIRECCION,
  HORARIO,
  NOTA_VOLUMEN,
  TELEFONOS,
  VIDEO_HEROE,
  urlComoLlegar,
  urlMapaIncrustado,
  urlTelefono,
} from '@/data/empresa';

/**
 * Portada de catálogo.
 *
 * Orden: héroe → productos → nosotros → servicios → especies → ubicación.
 *
 * Las secciones se separan SOLO por color de fondo: cal → aserrín → verde-tinta
 * → cal → aserrín. No hay filetes de división en ningún lado.
 */
const especies = await obtenerEspecies();
const productos = await obtenerProductos();
const servicios = await obtenerServicios();

/** En la portada van seis; los once están en /productos. */
const DESTACADOS = 6;
const productosDestacados = productos.slice(0, DESTACADOS);

const nombreEspecie = (slug: string): string | undefined =>
  especies.find((especie) => especie.slug === slug)?.nombre;

/**
 * OJO: `planta-taller.jpg` y `heroe.jpg` son de relleno, con licencia libre.
 * Ver CREDITOS-RELLENO.json. Hay que cambiarlas por fotos de la planta.
 */
const fotoPlanta = {
  toma: 'Vista general del área de trabajo de la planta, con la madera dimensionada al fondo',
  alt: 'Área de trabajo de la planta con madera dimensionada y herramienta sobre el banco',
  proporcion: '3/2',
  archivo: 'planta-taller.jpg',
} as const;
---

<Base
  titulo="Maderas de Honduras"
  descripcion="Aserradero y planta procesadora en Honduras. Pino, roble, caoba y cedro cortados a pedido, secados, cepillados y curados en la misma planta. Km 60, carretera a Olancho."
  contexto={{ tipo: 'inicio' }}
>
  {/*
    Héroe a sangre con fondo de video.

    Mientras `VIDEO_HEROE` sea `null` se pinta la foto. Cuando el cliente
    entregue el video se llena esa constante en `data/empresa.ts` y esto pasa a
    `<video>` solo, sin tocar nada más. Va silenciado, en bucle y con `poster`,
    y `prefers-reduced-motion` lo congela en el póster.
  */}
  <section class="relative isolate flex min-h-[78svh] items-end overflow-hidden bg-verde-tinta">
    {
      VIDEO_HEROE !== null ? (
        <video
          class="heroe-fondo absolute inset-0 -z-10 h-full w-full object-cover"
          src={VIDEO_HEROE}
          poster={heroe.src}
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
        />
      ) : (
        <Image
          src={heroe}
          alt=""
          widths={[720, 1280, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="heroe-fondo-entra absolute inset-0 -z-10 h-full w-full object-cover"
        />
      )
    }

    {/*
      Velo en degradado, no plano. Al 80% parejo la foto desaparecía y el héroe
      se veía como un bloque verde liso.

      Va opaco abajo, que es donde se apoya el texto, y se abre hacia arriba
      para que se lea la madera. No es decoración: sin él, texto claro sobre una
      foto no llega al contraste mínimo, y la foto además va a cambiar.
    */}
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-verde-tinta via-verde-tinta/85 to-verde-tinta/35"
      aria-hidden="true"
    >
    </div>

    <div class="plano pb-16 pt-28 lg:pb-24 lg:pt-40">
      <h1 class="heroe-entra text-display-hero text-cal">Maderas de Honduras</h1>

      <p class="heroe-entra mt-6 max-w-medida text-lead text-aserrin" style="--retraso: 110ms">
        Aserradero y planta procesadora. Cortamos pino, roble, caoba y cedro para tu
        obra, y los secamos, cepillamos y curamos en la misma planta. {NOTA_VOLUMEN}.
      </p>

      <div class="heroe-entra mt-9 flex flex-wrap gap-3" style="--retraso: 220ms">
        <a href="/productos" class="boton-cotizar">
          Ver productos
          <span class="flecha" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/contacto" class="boton-linea-claro">Pedir precio</a>
      </div>
    </div>
  </section>

  <!-- Productos · cal -->
  <section class="bg-cal">
    <div class="plano py-14 lg:py-20">
      <h2 class="revelar rotulo">Productos</h2>

      <ul class="collage mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          productosDestacados.map((producto, i) => (
            <li class="tarjeta revelar" style={`--retraso: ${i * 100}ms`}>
              <div class="marco-especie">
                <MarcadorFoto foto={producto.foto} tono="monte" proporcion="3/2" />
              </div>
              <p class="mt-4 text-display-2 text-verde-tinta">{producto.nombre}</p>
              <p class="mt-1.5 text-sm text-verde-monte">
                {producto.especies.map(nombreEspecie).filter(Boolean).join(' · ')}
              </p>
            </li>
          ))
        }
      </ul>

      <a href="/productos" class="boton-cotizar mt-12">
        Ver todos los productos
        <span class="flecha" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Nosotros · aserrín -->
  <section class="bg-aserrin">
    <div class="plano grid gap-10 py-14 lg:grid-cols-2 lg:items-center lg:gap-14 lg:py-20">
      <div>
        <h2 class="revelar rotulo">Nosotros</h2>
        <p class="mt-6 max-w-medida text-lead text-verde-tinta">
          Planta propia desde {ANIO_PLANTA_PROPIA}. Aserramos, dimensionamos, secamos, cepillamos y
          curamos en el mismo lugar, y por eso la pieza sale como la pediste y no como había.
        </p>
        <a href="/nosotros" class="boton-linea mt-8">
          Conocenos
          <span class="flecha" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div>
        <MarcadorFoto foto={fotoPlanta} tono="monte" proporcion="3/2" />
      </div>
    </div>
  </section>

  <!-- Servicios · verde tinta -->
  <section class="bg-verde-tinta text-cal">
    <div class="plano py-14 lg:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="revelar rotulo-claro">Servicios</h2>
        <a href="/servicios" class="enlace-claro -my-2 inline-flex min-h-[44px] items-center text-sm">Ver los servicios</a>
      </div>

      <ul class="collage mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          servicios.map((servicio, i) => (
            <li class="tarjeta revelar" style={`--retraso: ${i * 100}ms`}>
              <div class="marco-especie">
                <MarcadorFoto foto={servicio.foto} tono="tinta" proporcion="3/2" />
              </div>
              <p class="mt-4 text-display-2 text-cal">{servicio.nombre}</p>
              <p class="mt-1.5 text-sm text-aserrin">{servicio.especificacion}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Especies · cal -->
  <section class="bg-cal">
    <div class="plano py-14 lg:py-20">
      <h2 class="revelar rotulo">Especies</h2>
      <ul class="collage mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          especies.map((especie, i) => (
            <li class="tarjeta revelar" style={`--retraso: ${i * 100}ms`}>
              <div class="marco-especie">
                <MarcadorFoto foto={especie.foto} tono="monte" proporcion="3/2" />
              </div>
              <p class="mt-4 text-display-2 text-verde-tinta">{especie.nombre}</p>
              <p class="mt-1.5 text-sm text-verde-monte">
                {especie.acabados.map((a) => ETIQUETA_ACABADO[a]).join(' · ')}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Ubicación · aserrín -->
  <section class="bg-aserrin">
    <div class="plano grid gap-10 py-14 lg:grid-cols-2 lg:gap-14 lg:py-20">
      <div>
        <h2 class="revelar rotulo">Ubicación</h2>
        <p class="mt-4 max-w-medida text-base text-verde-tinta">{DIRECCION.linea}</p>

        <ul class="mt-5 space-y-1">
          {
            TELEFONOS.map((telefono) => (
              <li>
                <a
                  href={urlTelefono(telefono)}
                  class="-my-1 inline-flex min-h-[44px] items-center text-dato-lg text-verde-tinta transition-colors duration-micro ease-sierra hover:text-ocote-tinta"
                >
                  {telefono}
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="rotulo mt-10">Horario</h3>
        <ul class="mt-4 max-w-medida space-y-2">
          {
            HORARIO.map((franja) => (
              <li class="flex flex-wrap justify-between gap-x-4 text-base">
                <span class="text-verde-monte">{franja.dias}</span>
                <span class="text-dato-sm text-verde-tinta">
                  {franja.abre === null ? 'Cerrado' : `${franja.abre} – ${franja.cierra}`}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={urlComoLlegar()} target="_blank" rel="noopener noreferrer" class="boton-cotizar">
            Cómo llegar
            <span class="flecha" aria-hidden="true">&rarr;</span>
          </a>
          <a href="/contacto" class="boton-linea">Pedir precio</a>
        </div>
      </div>

      {/*
        Mapa incrustado desde el pin que pasó el cliente. `output=embed` no pide
        clave de API. Va diferido: es un iframe a Google y no tiene por qué
        cargar antes que el contenido propio.
      */}
      <div class="aspect-[4/3] w-full lg:aspect-auto lg:min-h-[26rem]">
        <iframe
          src={urlMapaIncrustado()}
          title="Mapa con la ubicación de la planta de Maderas de Honduras"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-full w-full"></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Si el visitante pidió no ver movimiento, el video se congela en su póster. */
  @media (prefers-reduced-motion: reduce) {
    .heroe-fondo {
      display: none;
    }
  }
</style>
