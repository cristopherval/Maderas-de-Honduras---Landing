---
import Base from '@/layouts/Base.astro';
import MarcadorFoto from '@/components/MarcadorFoto.astro';
import { ANIO_PLANTA_PROPIA, ANIOS_EN_EL_RUBRO, DIRECCION } from '@/data/empresa';

/**
 * Corta y sin épica. Se fue la banda de estadísticas (especies, productos,
 * mínimo por envío, año) y se fue el bloque de "a quién le vendemos": listar
 * constructoras, arquitectos y madereras es otra forma de decirle al que
 * compra poco que no es su lugar.
 *
 * La historia es la que redactó el cliente, palabra por palabra.
 */

/**
 * Las dos tomas de la planta. Igual que en la portada, son de relleno con
 * licencia libre —ver CREDITOS-RELLENO.json— y hay que cambiarlas por fotos
 * reales antes de publicar.
 */
const FOTOS_PLANTA = [
  {
    toma: 'El portón de entrada con el rótulo de la empresa, desde la calle hacia Valle Arriba',
    alt: 'Entrada de la planta con madera apilada',
    proporcion: '3/2',
    archivo: 'planta-tabla.jpg',
  },
  {
    toma: 'El equipo de la planta en el área de dimensionado, sin poses, trabajando',
    alt: 'Área de dimensionado de la planta con herramienta y madera sobre el banco',
    proporcion: '3/2',
    archivo: 'planta-taller.jpg',
  },
] as const;
---

<Base
  titulo="Nosotros"
  descripcion={`Aserradero y planta procesadora propia desde ${ANIO_PLANTA_PROPIA}. ${DIRECCION.corta}. Puede visitarnos.`}
  contexto={{ tipo: 'nosotros' }}
>
  <section class="bg-cal">
    <div class="plano pb-10 pt-14 lg:pt-20">
    <h1 class="revelar max-w-[18ch] text-display-hero text-verde-tinta">
      {ANIOS_EN_EL_RUBRO} años en el rubro forestal
    </h1>
    {/* Redacción del cliente, tal cual la pasó. */}
    <p class="revelar mt-6 max-w-medida text-lead text-verde-tinta" style="--retraso: 90ms">
      Se inició revendiendo madera, después alquilando locales con maquinaria, para después tener
      una planta procesadora propia desde el año {ANIO_PLANTA_PROPIA} hasta la fecha.
    </p>
    </div>
  </section>

  <section class="bg-aserrin">
    <div class="plano py-10 lg:py-14">
      <h2 class="revelar rotulo">La planta</h2>
      <p class="mt-4 max-w-medida text-base text-verde-tinta">
        {DIRECCION.linea}. Puede visitarnos en horario de trabajo.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          FOTOS_PLANTA.map((foto, indice) => (
            <MarcadorFoto foto={foto} tono={indice === 0 ? 'monte' : 'tinta'} proporcion="3/2" />
          ))
        }
      </div>
    </div>
  </section>

</Base>
