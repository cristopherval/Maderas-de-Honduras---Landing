---
import Base from '@/layouts/Base.astro';
import MarcadorFoto from '@/components/MarcadorFoto.astro';
import { obtenerEspecies, productosPorCategoria } from '@/lib/contenido';
import { NOTA_VOLUMEN } from '@/data/empresa';

/**
 * El catálogo. Nombre del producto, en qué especies sale y cómo se vende.
 *
 * Nada de párrafos explicando para qué sirve cada cosa: quien busca machimbre
 * ya sabe qué es el machimbre. Es el criterio de los dos aserraderos que puso
 * el cliente de referencia.
 */
const grupos = await productosPorCategoria();
const especies = await obtenerEspecies();

const nombreEspecie = (slug: string): string | undefined =>
  especies.find((especie) => especie.slug === slug)?.nombre;
---

<Base
  titulo="Productos"
  descripcion="Tabla para construcción, madera en cuadro, timber, machimbre, pallets, palillo, bolillos, capote, leña, ocote y aserrín. En pino, roble, caoba y cedro."
  contexto={{ tipo: 'producto', nombre: 'varios productos' }}
>
  <section class="bg-cal">
    <div class="plano pb-10 pt-14 lg:pt-20">
    <h1 class="revelar text-display-hero text-verde-tinta">Productos</h1>
    <p class="revelar mt-6 max-w-medida text-lead text-verde-tinta" style="--retraso: 90ms">
      Todos se elaboran en pino, roble, caoba o cedro, según el producto. Si no encuentra lo que
      busca, escríbanos y lo resolvemos. {NOTA_VOLUMEN}.
    </p>
    </div>
  </section>

  {
    grupos.map((grupo) => (
      <section class="bg-aserrin">
        <div class="plano py-10 lg:py-14">
          <h2 class="revelar rotulo">{grupo.etiqueta}</h2>

          <ul class="collage mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
            {grupo.productos.map((producto, i) => (
              <li id={producto.slug} class="tarjeta revelar" style={`--retraso: ${i * 100}ms`}>
                <div class="marco-especie">
                  <MarcadorFoto foto={producto.foto} tono="monte" proporcion="3/2" />
                </div>
                <p class="mt-4 text-display-2 text-verde-tinta">{producto.nombre}</p>
                <p class="mt-1.5 text-sm text-verde-monte">
                  {producto.especies.map(nombreEspecie).filter(Boolean).join(' · ')}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

</Base>
