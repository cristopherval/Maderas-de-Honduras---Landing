---
import Base from '@/layouts/Base.astro';
import FormularioContacto from '@/components/isla/FormularioContacto';
import { DIRECCION, HORARIO, NOTA_VOLUMEN, TELEFONOS, urlComoLlegar, urlTelefono } from '@/data/empresa';
---

<Base
  titulo="Contacto"
  descripcion="Km 60, carretera a Olancho. Teléfonos, horario de planta y formulario para pedir precio."
  contexto={{ tipo: 'contacto' }}
>
  <section class="bg-cal">
    <div class="plano pb-10 pt-14 lg:pt-20">
    <h1 class="revelar max-w-[20ch] text-display-hero text-verde-tinta">Pedir precio</h1>
    <p class="revelar mt-6 max-w-medida text-lead text-verde-tinta" style="--retraso: 90ms">
      Los precios salen según volumen, especie y acabado, así que no están publicados. Contanos
      qué necesitás y te decimos. {NOTA_VOLUMEN}.
    </p>
    </div>
  </section>

  <section class="bg-aserrin">
    <div class="plano grid gap-12 py-10 lg:grid-cols-2 lg:gap-16 lg:py-14">
      <div>
        <h2 class="revelar rotulo">Contanos qué necesitás</h2>
        <div class="mt-6">
          <FormularioContacto client:load />
        </div>
      </div>

      <div>
        <h2 class="revelar rotulo">Planta</h2>
        <address class="mt-4 not-italic">
          <p class="max-w-medida text-base text-verde-tinta">{DIRECCION.linea}</p>
          <p class="mt-1 text-sm text-verde-monte">
            {DIRECCION.departamento}, {DIRECCION.pais}
          </p>
        </address>
        <a
          href={urlComoLlegar()}
          target="_blank"
          rel="noopener noreferrer"
          class="boton-linea mt-6"
        >
          Cómo llegar
          <span class="flecha" aria-hidden="true">&rarr;</span>
        </a>

        <h2 class="revelar rotulo mt-12">Teléfonos</h2>
        <ul class="mt-4">
          {
            TELEFONOS.map((telefono) => (
              <li class="py-2">
                <a
                  href={urlTelefono(telefono)}
                  class="-my-1 inline-flex min-h-[44px] items-center text-dato-lg text-verde-tinta transition-colors duration-micro ease-sierra hover:text-ocote-tinta"
                >
                  {telefono}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="revelar rotulo mt-12">Horario</h2>
        <ul class="mt-4">
          {
            HORARIO.map((franja) => (
              <li class="flex flex-wrap justify-between gap-x-4 py-1.5 text-base">
                <span class="text-verde-monte">{franja.dias}</span>
                <span class="text-dato-sm text-verde-tinta">
                  {franja.abre === null ? 'Cerrado' : `${franja.abre} – ${franja.cierra}`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
