---
import Base from '@/layouts/Base.astro';

const DESTINOS = [
  { href: '/productos', texto: 'Productos', detalle: 'Pino, roble, caoba y cedro' },
  { href: '/servicios', texto: 'Servicios', detalle: 'Corte, secado, cepillado y curado' },
  { href: '/nosotros', texto: 'Nosotros', detalle: 'La planta' },
  { href: '/contacto', texto: 'Contacto', detalle: 'Dirección, teléfonos y horario' },
];
---

<Base
  titulo="Esta página no existe"
  descripcion="La página que buscabas no está en el sitio."
  contexto={{ tipo: 'inicio' }}
  noIndexar
>
  <section class="plano py-20 lg:py-32">
    <p class="rotulo">Error 404</p>
    <h1 class="revelar mt-5 max-w-[18ch] text-display-hero text-verde-tinta">Esta página no existe</h1>
    <p class="mt-8 max-w-medida text-lead text-verde-tinta">
      O se movió, o el enlace venía mal escrito. Lo que sí existe está acá abajo.
    </p>

    <ul class="mt-12 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        DESTINOS.map((destino) => (
          <li class="">
            <a href={destino.href} class="group block">
              <span class="text-display-2 text-verde-tinta group-hover:text-verde-monte">
                {destino.texto}
              </span>
              <span class="mt-1 block text-dato-sm text-verde-monte">{destino.detalle}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-12">
      <a href="/contacto" class="boton-cotizar">
        Pedir precio
        <span class="flecha" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </section>
</Base>
