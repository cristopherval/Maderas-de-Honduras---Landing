---
import Base from '@/layouts/Base.astro';
import AyudaWhatsApp from '@/components/AyudaWhatsApp.astro';
import MarcadorFoto from '@/components/MarcadorFoto.astro';
import { obtenerServicios } from '@/lib/contenido';

/**
 * Reemplaza a la vieja página `/proceso`, que contaba las seis etapas de la
 * troza al despacho como si fuera un recorrido. Lo que el cliente vende no es
 * un recorrido: son cuatro servicios sobre la madera. Se lista y ya.
 */
const servicios = await obtenerServicios();
---

<Base
  titulo="Servicios"
  descripcion="Corte a pedido, secado, cepillado y curado. Todo en la misma planta, sobre pino, roble, caoba y cedro."
  contexto={{ tipo: 'proceso' }}
>
  <section class="bg-cal">
    <div class="plano pb-10 pt-14 lg:pt-20">
    <h1 class="revelar text-display-hero text-verde-tinta">Servicios</h1>
    <p class="revelar mt-6 max-w-medida text-lead text-verde-tinta" style="--retraso: 90ms">
      Los cuatro se hacen en la misma planta. Por eso la pieza sale como la pediste, y no con lo
      que había.
    </p>
    </div>
  </section>

  <section class="bg-aserrin">
    <div class="plano py-10 lg:py-14">
      <ul class="collage grid gap-x-10 gap-y-12 sm:grid-cols-2">
        {
          servicios.map((servicio, i) => (
            <li id={servicio.slug} class="tarjeta revelar" style={`--retraso: ${i * 100}ms`}>
              <div class="marco-especie">
                <MarcadorFoto foto={servicio.foto} tono="monte" proporcion="3/2" />
              </div>
              <h2 class="mt-5 text-display-2 text-verde-tinta">{servicio.nombre}</h2>
              <p class="mt-3 max-w-medida text-base text-verde-tinta">{servicio.que_hace}</p>
              <p class="mt-2 text-sm text-verde-monte">{servicio.especificacion}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-verde-tinta text-cal">
    <div class="plano py-12 lg:py-16">
      <AyudaWhatsApp mensaje="Buenas. Quiero consultar por corte, secado, cepillado o curado." />
    </div>
  </section>
</Base>
